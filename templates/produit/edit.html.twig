{% extends 'base.html.twig' %}

{% block title %}Modifier un produit{% endblock %}

{% block body %}
    <h1>Modifier le produit{{ produit.id }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.reference) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.date) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.stock) }}

        <button type="submit">Enregistrer les modifications</button>
    {{ form_end(form) }}

    <a href="{{ path('app_produit_index') }}">Retour à la liste</a>
{% endblock %}