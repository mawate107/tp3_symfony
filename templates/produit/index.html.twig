{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
    <h1>Produit index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Reference</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Date</th>
                <th>Prix</th>
                <th>Stock</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.id }}</td>
                <td>{{ produit.reference }}</td>
                <td>{{ produit.nom }}</td>
                <td>{{ produit.description }}</td>
                <td>{{ produit.date ? produit.date|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ produit.prix }}</td>
                <td>{{ produit.stock }}</td>
                <td>
                    <a href="{{ path('app_produit_show', {'id': produit.id}) }}">Détails produit_{{produit.id}}</a>

                </td>
                <td> <a href="{{ path('app_produit_edit', {'id': produit.id}) }}">Modifier</a></td>
                <td><form method="post" action="{{ path('app_produit_delete', {'id': produit.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                    <button type="submit">Supprimer</button>
                </form></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">pas de produit ajouté</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_produit_new') }}">Ajouter un produit</a>


{% endblock %}
